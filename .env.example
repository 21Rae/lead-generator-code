# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SERPAPI_KEY: API key for SerpAPI Google Search
SERPAPI_KEY=

# PDL_API_KEY: API key for People Data Labs person enrichment API
PDL_API_KEY=

# MIN_LIKELIHOOD_SCORE: Minimum PDL match confidence threshold (1-10, default 7)
MIN_LIKELIHOOD_SCORE=7

# OUTPUT_DESTINATION: Destination for enriched leads (e.g., csv, googlesheets, airtable, postgres)
OUTPUT_DESTINATION=csv
OUTPUT_DESTINATION_ID=
